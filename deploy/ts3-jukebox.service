[Unit]
Description=ts3-jukebox (TeamSpeak 3 song request panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/jukebox
ExecStart=/usr/bin/python3 -m jukebox -c /opt/jukebox/config.toml
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
